{
  "name": "offline-code-review-assistant",
  "version": "1.0.0",
  "description": "Offline ML-Based Code Review Assistant — A fully offline desktop application for intelligent code reviews",
  "main": "dist/electron/main.js",
  "author": "Code Review Assistant Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:electron\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "cd client && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev:server": "cd server && python app.py",
    "build": "npm run build:client && npm run build:electron",
    "build:client": "cd client && npm run build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "package": "npm run build && electron-builder",
    "train:models": "cd ml/training && python train_all.py",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "cd client && npm test",
    "test:integration": "cd tests && python -m pytest integration/ -v"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.3.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.codeassistant.offline",
    "productName": "Code Review Assistant",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "client/dist/**/*",
      "ml/models/**/*",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": ["**/*"]
      },
      {
        "from": "ml/models",
        "to": "models",
        "filter": ["**/*.joblib", "**/*.pkl", "**/*.json"]
      }
    ],
    "win": {
      "target": ["dir"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
